{
  "$schema": "https://irodori.dev/schemas/irodori.extension.schema.json",
  "manifestVersion": 1,
  "id": "irodori.pinecone",
  "name": "Pinecone Connector",
  "version": "0.1.2",
  "publisher": "irodori",
  "description": "Pinecone Connector contributes the Pinecone database connector through the native connector ABI.",
  "license": "MIT OR 0BSD",
  "repository": "https://github.com/hjosugi/irodori-extension-pinecone",
  "apiVersion": "0.1",
  "runtime": "native",
  "entry": "dist/native",
  "permissions": [
    "connections:read",
    "connections:write",
    "queries:run",
    "metadata:read",
    "native",
    "connectors"
  ],
  "contributes": {
    "connectors": [
      {
        "id": "pinecone.connector",
        "engine": "pinecone",
        "label": "Pinecone",
        "aliases": [
          "pinecone",
          "Pinecone"
        ],
        "defaultPort": 0,
        "wire": "pinecone",
        "module": "pinecone.driver",
        "features": [
          "metadata",
          "vectorSearch",
          "embeddingSearch",
          "hybridSearch",
          "queryTemplates",
          "visualization"
        ],
        "connection": {
          "schemaVersion": 1,
          "inferEnvironmentFrom": [
            "name",
            "id",
            "host",
            "database",
            "url"
          ],
          "compatibility": {
            "addsRequiredProfileFields": false,
            "acceptsExistingProfiles": true
          },
          "defaults": {
            "engine": "pinecone",
            "wire": "pinecone",
            "port": 0,
            "readOnly": false
          },
          "endpoint": {
            "modes": [
              "cloudResource",
              "customEndpoint"
            ],
            "defaultPort": 0,
            "fields": [
              {
                "id": "environment",
                "label": "Pinecone environment or region",
                "type": "string",
                "option": "environment"
              },
              {
                "id": "indexHost",
                "label": "Index host",
                "type": "uri",
                "profileField": "host"
              }
            ]
          },
          "profileFields": [
            {
              "id": "id",
              "label": "Connection ID",
              "type": "string",
              "profileField": "id",
              "required": true
            },
            {
              "id": "url",
              "label": "Connection URL or DSN",
              "type": "uri",
              "profileField": "url"
            },
            {
              "id": "user",
              "label": "User",
              "type": "string",
              "profileField": "user"
            },
            {
              "id": "environment",
              "label": "Pinecone environment or region",
              "type": "string",
              "option": "environment"
            },
            {
              "id": "indexHost",
              "label": "Index host",
              "type": "uri",
              "profileField": "host"
            },
            {
              "id": "readOnly",
              "label": "Read-only connection",
              "type": "boolean",
              "profileField": "readOnly",
              "default": false
            },
            {
              "id": "options",
              "label": "Driver options",
              "type": "map",
              "profileField": "options"
            }
          ],
          "authMethods": [
            {
              "id": "apiKey",
              "label": "Pinecone API key",
              "kind": "apiKey",
              "secretPurposes": [
                "token"
              ],
              "fields": [
                {
                  "id": "apiKey",
                  "label": "API key",
                  "type": "secret",
                  "secretPurpose": "token",
                  "required": true
                }
              ]
            },
            {
              "id": "customDriverOptions",
              "label": "Custom driver options",
              "kind": "custom",
              "secretPurposes": [
                "password",
                "token",
                "privateKey",
                "privateKeyPassphrase"
              ],
              "fields": [
                {
                  "id": "options",
                  "label": "Driver options",
                  "type": "map",
                  "profileField": "options"
                }
              ]
            }
          ],
          "secretPurposes": [
            "token",
            "password",
            "privateKey",
            "privateKeyPassphrase"
          ],
          "tls": {
            "supported": true,
            "requiredByDefault": false,
            "modes": [
              "disable",
              "prefer",
              "require",
              "verifyCa",
              "verifyFull",
              "clientCertificate"
            ],
            "fields": [
              {
                "id": "caCertificate",
                "label": "CA certificate",
                "type": "pem"
              },
              {
                "id": "clientCertificate",
                "label": "Client certificate",
                "type": "pem"
              },
              {
                "id": "clientPrivateKey",
                "label": "Client private key",
                "type": "pem",
                "secretPurpose": "privateKey"
              }
            ]
          },
          "transports": [
            "customEndpoint",
            "direct",
            "sshTunnel",
            "socks5Proxy",
            "httpConnectProxy",
            "proxyChain"
          ],
          "optionNamespaces": [
            "profile.options",
            "driver",
            "tls",
            "network",
            "pinecone"
          ],
          "customDriverOptions": true
        },
        "experience": {
          "schemaVersion": 1,
          "domains": [
            "vector"
          ],
          "inspiredBy": [
            "Pinecone indexes",
            "Pinecone namespaces",
            "Pinecone metadata filters"
          ],
          "resultViews": [
            "vectorNeighbors",
            "table",
            "json"
          ],
          "objectTypes": [
            "collections",
            "indexes",
            "vectors",
            "payloadFields",
            "partitions",
            "namespaces"
          ],
          "workflows": [
            {
              "id": "vector-similarity-search",
              "label": "Similarity search",
              "description": "Search nearest neighbors from a pasted vector or embedding variable.",
              "resultView": "vectorNeighbors",
              "templateIds": [
                "vector-similarity"
              ]
            },
            {
              "id": "vector-filtered-search",
              "label": "Filtered ANN search",
              "description": "Combine vector similarity with metadata or scalar filters.",
              "resultView": "vectorNeighbors",
              "templateIds": [
                "vector-filtered"
              ]
            },
            {
              "id": "vector-health",
              "label": "Collection or index health",
              "description": "Inspect vector count, dimensionality, metric, shard, and index status.",
              "resultView": "table",
              "templateIds": [
                "vector-health"
              ]
            }
          ],
          "queryTemplates": [
            {
              "id": "vector-similarity",
              "label": "Pinecone query",
              "language": "json",
              "description": "Search topK nearest records in a namespace.",
              "insertText": "{\n  \"namespace\": \"$namespace\",\n  \"vector\": $vector,\n  \"topK\": 10,\n  \"includeMetadata\": true\n}",
              "parameters": [
                {
                  "id": "namespace",
                  "label": "Namespace",
                  "type": "string",
                  "default": "default"
                },
                {
                  "id": "vector",
                  "label": "Query vector",
                  "type": "json"
                }
              ],
              "resultView": "vectorNeighbors"
            },
            {
              "id": "vector-filtered",
              "label": "Pinecone filtered query",
              "language": "json",
              "description": "Search vectors with a metadata filter.",
              "insertText": "{\n  \"namespace\": \"$namespace\",\n  \"vector\": $vector,\n  \"topK\": 10,\n  \"includeMetadata\": true,\n  \"filter\": {\n    \"$field\": { \"$eq\": \"$value\" }\n  }\n}",
              "parameters": [
                {
                  "id": "namespace",
                  "label": "Namespace",
                  "type": "string",
                  "default": "default"
                },
                {
                  "id": "vector",
                  "label": "Query vector",
                  "type": "json"
                },
                {
                  "id": "field",
                  "label": "Metadata field",
                  "type": "string"
                },
                {
                  "id": "value",
                  "label": "Metadata value",
                  "type": "string"
                }
              ],
              "resultView": "vectorNeighbors"
            },
            {
              "id": "vector-health",
              "label": "Pinecone index stats",
              "language": "text",
              "description": "Inspect namespaces, dimensions, and vector counts.",
              "insertText": "POST /describe_index_stats\n{}",
              "parameters": [
                {
                  "id": "namespace",
                  "label": "Namespace",
                  "type": "string",
                  "default": "default"
                }
              ],
              "resultView": "table"
            }
          ],
          "inspectorHints": [
            {
              "id": "vector-dimension",
              "label": "Dimension badge",
              "description": "Surface vector dimension and distance metric beside each collection or index."
            },
            {
              "id": "vector-payload",
              "label": "Payload fields",
              "description": "Show filterable metadata fields before composing a filtered search."
            }
          ]
        }
      }
    ]
  },
  "capabilities": {
    "nativeModules": [
      {
        "id": "pinecone.driver",
        "path": "dist/native",
        "platforms": [
          "windowsX64",
          "windowsArm64",
          "macosX64",
          "macosArm64",
          "linuxX64",
          "linuxArm64"
        ]
      }
    ]
  },
  "dev": {
    "watch": [
      "src",
      "connector.config.json",
      "irodori.extension.json"
    ]
  }
}
