          "label": "Index host",
          "type": "uri",
          "profileField": "host"
        },
        {
          "id": "readOnly",
          "label": "Read-only connection",
          "type": "boolean",
          "profileField": "readOnly",
          "default": false
        },
        {
          "id": "options",
          "label": "Driver options",
          "type": "map",
          "profileField": "options"
        }
      ],
      "authMethods": [
        {
          "id": "apiKey",
